# MongoDB 连接配置
# DataCenter 库：包含 VI_ICU_ZYYZ 等医嘱视图/集合
MONGO_DATACENTER_URI=mongodb://127.0.0.1:27017/DataCenter

# SmartCare 库：包含 patient、bedside 等集合
MONGO_SMARTCARE_URI=mongodb://127.0.0.1:27017/SmartCare

# 服务端口
SERVER_PORT=3000

# MongoDB 连接超时时间，单位毫秒
MONGO_TIMEOUT_MS=10000

# 是否按科室字段过滤；默认 false 更安全，避免源数据无科室字段时统计为 0
ENABLE_DEPT_FILTER=false

# 时区
TZ=Asia/Shanghai

# ── 营养质量控制指标监测 ──────────────────────────────
# 是否启用营养质量控制指标监测功能
NUTRITION_QUALITY_ENABLED=true

# 肠内营养记录单集合名（留空则不查询，需手动配置或启用自动发现）
NUTRITION_QUALITY_COLLECTION=

# 有效记录的valid字段值（默认 "valid"）
NUTRITION_QUALITY_VALID_VALUE=valid

# 默认科室代码
NUTRITION_QUALITY_DEPT_CODE=0211

# 营养质量时区
NUTRITION_QUALITY_TIMEZONE=Asia/Shanghai

# 是否自动发现集合（通过 _class 字段匹配）
NUTRITION_QUALITY_AUTO_DISCOVER_COLLECTION=false

# _class 匹配模式（用于自动发现）
NUTRITION_QUALITY_CLASS_PATTERN=PatCnyyRestraintLjrmyy
